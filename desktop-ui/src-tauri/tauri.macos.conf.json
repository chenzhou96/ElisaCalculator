{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "npm run build && python3 scripts/build-bridge-macos.py"
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "resources": {
      "resources/bridge/elisa_bridge": "bridge/elisa_bridge"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
