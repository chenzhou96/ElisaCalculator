{
  "name": "desktop-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:bridge": "powershell -ExecutionPolicy Bypass -File ./scripts/build-bridge-exe.ps1",
    "tauri:bridge:health": "powershell -ExecutionPolicy Bypass -File ./scripts/bridge-health-check.ps1",
    "tauri:prepare:offline-tools": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-offline-tools.ps1",
    "tauri:build:nsis:offline": "tauri build --bundles nsis",
    "tauri:build:msi:offline": "tauri build --bundles msi",
    "test": "node --experimental-strip-types --test tests/model.test.mjs tests/record.test.mjs",
    "test:e2e": "playwright test",
    "test:integration": "node --test tests/dom.integration.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
